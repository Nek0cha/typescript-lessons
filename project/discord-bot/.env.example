# このファイルをコピーして .env を作り、実際の値を入れてください。
# .env自体はGitに含めないこと（.gitignoreで除外済み）。

# Discord Developer Portal の Bot > Token で取得
DISCORD_TOKEN=

# Discord Developer Portal の General Information > Application ID
DISCORD_CLIENT_ID=

# スラッシュコマンドを特定のサーバーだけに即時反映したい場合に指定（開発中はこちらを推奨）
# サーバーを右クリック→「サーバーIDをコピー」（開発者モードを有効にしておく必要あり）
DISCORD_GUILD_ID=
